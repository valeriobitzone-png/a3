{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "a3/a3uisurface",
  "title": "A3UISurface v0.2",
  "type": "object",
  "required": [
    "id",
    "projection_ref",
    "presentation_ref",
    "lineage",
    "density_hint",
    "color_tokens",
    "motion",
    "morph",
    "gestures",
    "haptics",
    "nodes",
    "bindings",
    "produced_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "projection_ref": {
      "type": "string"
    },
    "presentation_ref": {
      "type": "string"
    },
    "lineage": {
      "type": "object",
      "required": [
        "state_identity",
        "source_state_version",
        "causal_event_id"
      ],
      "properties": {
        "state_identity": {
          "type": "string"
        },
        "source_state_version": {
          "type": "integer",
          "minimum": 0
        },
        "causal_event_id": {
          "type": "string"
        },
        "future_state_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "forecast_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "density_hint": {
      "enum": [
        "compact",
        "comfortable",
        "spacious"
      ]
    },
    "color_tokens": {
      "type": "array",
      "items": {
        "enum": [
          "accent",
          "anticipation_highlight",
          "success"
        ]
      }
    },
    "motion": {
      "type": "object",
      "required": [
        "stiffness",
        "damping",
        "curve",
        "duration_hint"
      ],
      "properties": {
        "stiffness": {
          "type": "number"
        },
        "damping": {
          "type": "number"
        },
        "curve": {
          "type": "string"
        },
        "duration_hint": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "morph": {
      "type": "object",
      "required": [
        "to",
        "mode",
        "shared",
        "motion"
      ],
      "properties": {
        "to": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "shared-element",
            "crossfade"
          ]
        },
        "shared": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "motion": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "gestures": {
      "type": "object",
      "required": [
        "bindings"
      ],
      "properties": {
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "gesture",
              "action",
              "target_node_id"
            ],
            "properties": {
              "gesture": {
                "type": "string"
              },
              "action": {
                "enum": [
                  "confirm",
                  "dismiss",
                  "select",
                  "next-step"
                ]
              },
              "target_node_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "haptics": {
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event",
              "pattern",
              "intensity_hint"
            ],
            "properties": {
              "event": {
                "type": "string"
              },
              "pattern": {
                "type": "string"
              },
              "intensity_hint": {
                "enum": [
                  "light",
                  "medium",
                  "strong"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "atom_key",
          "node_id",
          "role"
        ],
        "properties": {
          "atom_key": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "content",
              "placeholder",
              "value"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "prefetch": {
      "type": "object",
      "required": [
        "candidate_ref",
        "base_state_version",
        "confidence",
        "ttl_ms",
        "status"
      ],
      "properties": {
        "candidate_ref": {
          "type": "string"
        },
        "base_state_version": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "prepared",
            "invalidated",
            "expired"
          ]
        },
        "atom_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "role",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "stack",
            "row",
            "list",
            "item",
            "action",
            "field",
            "text"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          }
        },
        "axis": {
          "type": "object",
          "properties": {
            "support": {
              "enum": [
                "high",
                "medium",
                "low",
                "unknown"
              ]
            },
            "freshness": {
              "enum": [
                "fresh",
                "aging",
                "stale"
              ]
            },
            "status": {
              "enum": [
                "believed",
                "held",
                "contradicted"
              ]
            },
            "action": {
              "enum": [
                "na",
                "pending",
                "unknown",
                "done",
                "compensated"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
