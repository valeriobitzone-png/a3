{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "a3/plan",
  "type": "object",
  "required": [
    "id",
    "goal_ref",
    "steps",
    "expected_outcome"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "goal_ref": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "executing",
        "done",
        "aborted"
      ]
    },
    "expected_outcome": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "seq",
          "capability",
          "trust_tier"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "capability": {
            "type": "string"
          },
          "trust_tier": {
            "enum": [
              "read",
              "prepare",
              "commit",
              "irreversible"
            ]
          },
          "reversible": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}