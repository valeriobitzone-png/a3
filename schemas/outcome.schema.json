{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "a3/outcome",
  "type": "object",
  "required": [
    "id",
    "goal_ref",
    "state_delta",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "goal_ref": {
      "type": "string"
    },
    "state_delta": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "k",
          "v",
          "confidence",
          "source",
          "observed_at"
        ],
        "properties": {
          "k": {
            "type": "string"
          },
          "v": {},
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "cost": {
      "type": "object"
    },
    "reversibility": {
      "enum": [
        "reversible",
        "irreversible"
      ]
    },
    "status": {
      "enum": [
        "proposed",
        "achieved",
        "failed"
      ]
    }
  },
  "additionalProperties": false
}