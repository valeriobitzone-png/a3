{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "a3/capability",
  "type": "object",
  "required": [
    "id",
    "name",
    "preconditions",
    "effects"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "k",
          "v",
          "confidence",
          "source",
          "observed_at"
        ],
        "properties": {
          "k": {
            "type": "string"
          },
          "v": {},
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "k",
          "v",
          "confidence",
          "source",
          "observed_at"
        ],
        "properties": {
          "k": {
            "type": "string"
          },
          "v": {},
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "cost": {
      "type": "object",
      "properties": {
        "money": {
          "type": "number"
        },
        "timeMin": {
          "type": "number"
        },
        "energy": {
          "enum": [
            "low",
            "med",
            "high"
          ]
        }
      },
      "additionalProperties": false
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "reversible": {
      "type": "boolean"
    },
    "reliability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "privacy": {
      "enum": [
        "local-first",
        "device",
        "account",
        "third-party"
      ]
    },
    "deps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adapter": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}