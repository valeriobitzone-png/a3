{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "a3/observation",
  "type": "object",
  "required": [
    "id",
    "execution_ref",
    "t",
    "facts"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "execution_ref": {
      "type": "string"
    },
    "t": {
      "type": "string",
      "format": "date-time"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "k",
          "v",
          "confidence",
          "source",
          "observed_at"
        ],
        "properties": {
          "k": {
            "type": "string"
          },
          "v": {},
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}