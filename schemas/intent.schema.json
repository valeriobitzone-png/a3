{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "a3/intent",
  "type": "object",
  "required": [
    "id",
    "expression",
    "modality",
    "source",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "expression": {
      "type": "string"
    },
    "modality": {
      "enum": [
        "voice",
        "text",
        "gesture",
        "context"
      ]
    },
    "source": {
      "enum": [
        "explicit",
        "inferred"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "goal_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}